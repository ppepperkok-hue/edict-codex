# Runtime data (machine-specific) - keep only the schema and default config
# template in version control.
/data/*
!/data/schema.json
!/data/config.default.json

# Logs
*.log
/tmp/

# Environment
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# macOS
.DS_Store
*.swp

# Node.js
node_modules/
edict/frontend/node_modules/
edict/frontend/dist/
*.tsbuildinfo

# Vite cache
.vite/

# IDE
.vscode/

# Backups
*.bak*

# Local dev/test scripts
_*.py

# OpenClaw-only scripts/tests (retained in source history, not shipped)
scripts/agentrec_advisor.py
scripts/apply_model_changes.py
scripts/linucb_router.py
scripts/run_loop.sh
scripts/sync_agent_config.py
scripts/sync_from_openclaw_runtime.py
tests/test_sync_agent_config.py
tests/test_sync_symlinks.py

# Generated docs
*.docx
*.pdf
