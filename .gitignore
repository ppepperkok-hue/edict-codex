# Runtime data (machine-specific) - keep only the schema and default config
# template in version control.
/data/*
!/data/schema.json
!/data/config.default.json
!/data/.gitkeep

# Logs
*.log
/tmp/

# Environment
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# macOS
.DS_Store
*.swp

# Node.js
node_modules/
edict/frontend/node_modules/
edict/frontend/dist/
*.tsbuildinfo

# Vite cache
.vite/

# IDE
.vscode/

# Backups
*.bak*

# Local dev/test scripts
_*.py
!**/__init__.py
/work/

# Generated docs
*.docx
*.pdf
